-- ═══════ SILENT AIM ═══════
local function getTarget()
    local closest, closestDist = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                if Config.SilentAim.TeamCheck 
                   and plr.Team ~= nil and LP.Team ~= nil 
                   and plr.Team == LP.Team then
                    continue
                end
                local part = plr.Character:FindFirstChild(Config.SilentAim.TargetPart) 
                    or plr.Character:FindFirstChild("Head")
                if part then
                    local worldDist = (Camera.CFrame.Position - part.Position).Magnitude
                    if worldDist <= Config.SilentAim.MaxDistance then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local dist = (center - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                            if dist <= Config.SilentAim.FOV and dist < closestDist then
                                closestDist = dist
                                closest = plr
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function getTargetPart()
    local target = getTarget()
    if not target or not target.Character then return nil end
    return target.Character:FindFirstChild(Config.SilentAim.TargetPart) 
        or target.Character:FindFirstChild("Head")
end

task.spawn(function()
    print("[tungWare] Поиск Blaster.Utility.castRays...")
    local Blaster = ReplicatedStorage:WaitForChild("Blaster", 15)
    if not Blaster then warn("[tungWare] Blaster не найден"); return end
    print("[tungWare] Blaster найден")
    
    local Utility = Blaster:WaitForChild("Utility", 15)
    if not Utility then warn("[tungWare] Utility не найден"); return end
    print("[tungWare] Utility найден")
    
    local castRaysModule = Utility:WaitForChild("castRays", 15)
    if not castRaysModule then warn("[tungWare] castRays не найден"); return end
    print("[tungWare] castRays найден: " .. castRaysModule.ClassName)
    
    local success, result = pcall(require, castRaysModule)
    if not success then warn("[tungWare] Ошибка require: " .. tostring(result)); return end
    print("[tungWare] castRays загружен: " .. typeof(result))
    
    local originalFunc = result
    if typeof(result) == "table" then
        for k, v in pairs(result) do
            if typeof(v) == "function" then
                originalFunc = v
                print("[tungWare] Функция в таблице: " .. tostring(k))
                break
            end
        end
    end
    
    if typeof(originalFunc) ~= "function" then
        warn("[tungWare] Не найдена функция внутри castRays"); return
    end
    
    if not hookfunction then
        warn("[tungWare] hookfunction недоступен!"); return
    end
    print("[tungWare] hookfunction OK, ставим хук...")
    
    local function newCastRays(player, origin, directions, ...)
        local isLocal = (player == LP)
        if isLocal and Config.SilentAim.Enabled and typeof(directions) == "table" then
            for k, _ in pairs(directions) do
                directions[k] = Vector3.new(0, 0, -1)
            end
        end
        local result = originalFunc(player, origin, directions, ...)
        if isLocal and Config.SilentAim.Enabled then
            local targetPart = getTargetPart()
            if targetPart and (Config.SilentAim.HitChance / 100) >= math.random() then
                if typeof(result) == "table" then
                    if result.position then
                        result.position = targetPart.Position
                        result.instance = targetPart
                        if targetPart.Parent then
                            result.taggedHumanoid = targetPart.Parent:FindFirstChildOfClass("Humanoid")
                        end
                        return result
                    end
                    if result[1] and typeof(result[1]) == "table" then
                        result[1].position = targetPart.Position
                        result[1].instance = targetPart
                        if targetPart.Parent then
                            result[1].taggedHumanoid = targetPart.Parent:FindFirstChildOfClass("Humanoid")
                        end
                        return result
                    end
                end
            end
        end
        return result
    end
    
    local hookSuccess, hookErr = pcall(function()
        originalFunc = hookfunction(originalFunc, newCastRays)
    end)
    if not hookSuccess then warn("[tungWare] Ошибка хука: " .. tostring(hookErr)); return end
    print("[tungWare] ============================================")
    print("[tungWare] SILENT AIM УСТАНОВЛЕН!")
    print("[tungWare] ============================================")
end)

RunService.RenderStepped:Connect(function()
    if fovCircle then
        fovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        fovCircle.Radius = Config.SilentAim.FOV
        fovCircle.Visible = Config.SilentAim.ShowFOV and Config.SilentAim.Enabled
    end
    if snapLine then
        if Config.SilentAim.Snapline and Config.SilentAim.Enabled then
            local target = getTarget()
            if target and target.Character then
                local part = target.Character:FindFirstChild(Config.SilentAim.TargetPart) 
                    or target.Character:FindFirstChild("Head")
                if part then
                    local sp, on = Camera:WorldToViewportPoint(part.Position)
                    if on then
                        snapLine.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                        snapLine.To = Vector2.new(sp.X, sp.Y)
                        snapLine.Visible = true
                    else snapLine.Visible = false end
                else snapLine.Visible = false end
            else snapLine.Visible = false end
        else snapLine.Visible = false end
    end
end)

-- ═══════ ESP ═══════
local espCache = {}

local function createESP(plr)
    if not hasDrawing or espCache[plr] then return end
    local e = {
        Box = Drawing.new("Square"), BoxOutline = Drawing.new("Square"),
        NameTag = Drawing.new("Text"), DistTag = Drawing.new("Text"),
        HealthBg = Drawing.new("Square"), HealthFill = Drawing.new("Square"),
        Skeleton = {},
    }
    e.Box.Thickness = 1.2; e.Box.Filled = false; e.Box.Color = Color3.fromRGB(255, 40, 40)
    e.BoxOutline.Thickness = 3; e.BoxOutline.Filled = false; e.BoxOutline.Color = Color3.fromRGB(0, 0, 0)
    e.NameTag.Size = 11; e.NameTag.Center = true; e.NameTag.Outline = true; e.NameTag.Color = Color3.fromRGB(255, 255, 255)
    e.DistTag.Size = 10; e.DistTag.Center = true; e.DistTag.Outline = true; e.DistTag.Color = Color3.fromRGB(255, 200, 100)
    e.HealthBg.Thickness = 1; e.HealthBg.Filled = true; e.HealthBg.Color = Color3.fromRGB(0, 0, 0)
    e.HealthFill.Thickness = 1; e.HealthFill.Filled = true; e.HealthFill.Color = Color3.fromRGB(80, 220, 80)
    for i = 1, 6 do
        local l = Drawing.new("Line"); l.Thickness = 1; l.Color = Color3.fromRGB(255, 40, 40)
        table.insert(e.Skeleton, l)
    end
    espCache[plr] = e
end

local function removeESP(plr)
    local e = espCache[plr]
    if e then
        for _, obj in ipairs({e.Box, e.BoxOutline, e.NameTag, e.DistTag, e.HealthBg, e.HealthFill}) do
            pcall(function() obj:Remove() end)
        end
        for _, l in ipairs(e.Skeleton) do pcall(function() l:Remove() end) end
        espCache[plr] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LP then createESP(p) end
end
Players.PlayerAdded:Connect(function(p) task.wait(0.5); createESP(p) end)
Players.PlayerRemoving:Connect(removeESP)

local function getSkeletonPoints(char)
    return char:FindFirstChild("Head"),
        char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"),
        char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm"),
        char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm"),
        char:FindFirstChild("LeftFoot") or char:FindFirstChild("Left Leg"),
        char:FindFirstChild("RightFoot") or char:FindFirstChild("Right Leg")
end

local function getBounds(char)
    local minV = Vector3.new(math.huge, math.huge, math.huge)
    local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)
    local found = false
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            found = true
            local cf = part.CFrame; local sz = part.Size / 2
            for xi = -1, 1, 2 do for yi = -1, 1, 2 do for zi = -1, 1, 2 do
                local corner = (cf * CFrame.new(sz.X * xi, sz.Y * yi, sz.Z * zi)).Position
                minV = Vector3.new(math.min(minV.X, corner.X), math.min(minV.Y, corner.Y), math.min(minV.Z, corner.Z))
                maxV = Vector3.new(math.max(maxV.X, corner.X), math.max(maxV.Y, corner.Y), math.max(maxV.Z, corner.Z))
            end end end
        end
    end
    if not found then return nil, nil end
    return minV, maxV
end

local function projectBounds(minV, maxV)
    local corners = {
        Vector3.new(minV.X, minV.Y, minV.Z), Vector3.new(maxV.X, minV.Y, minV.Z),
        Vector3.new(minV.X, maxV.Y, minV.Z), Vector3.new(maxV.X, maxV.Y, minV.Z),
        Vector3.new(minV.X, minV.Y, maxV.Z), Vector3.new(maxV.X, minV.Y, maxV.Z),
        Vector3.new(minV.X, maxV.Y, maxV.Z), Vector3.new(maxV.X, maxV.Y, maxV.Z),
    }
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local any = false
    for _, c in ipairs(corners) do
        local sp, on = Camera:WorldToViewportPoint(c)
        if on and sp.Z > 0 then
            any = true
            minX = math.min(minX, sp.X); minY = math.min(minY, sp.Y)
            maxX = math.max(maxX, sp.X); maxY = math.max(maxY, sp.Y)
        end
    end
    if not any then return nil end
    return minX, minY, maxX, maxY
end

local function updateESP()
    if not hasDrawing then return end
    for plr, e in pairs(espCache) do
        local visible = Config.ESP.Enabled
        if not visible then
            for _, obj in ipairs({e.Box, e.BoxOutline, e.NameTag, e.DistTag, e.HealthBg, e.HealthFill}) do obj.Visible = false end
            for _, l in ipairs(e.Skeleton) do l.Visible = false end
            continue
        end
        local char = plr.Character
        if not char then
            for _, obj in ipairs({e.Box, e.BoxOutline, e.NameTag, e.DistTag, e.HealthBg, e.HealthFill}) do obj.Visible = false end
            for _, l in ipairs(e.Skeleton) do l.Visible = false end
            continue
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hum or hum.Health <= 0 or not hrp then
            for _, obj in ipairs({e.Box, e.BoxOutline, e.NameTag, e.DistTag, e.HealthBg, e.HealthFill}) do obj.Visible = false end
            for _, l in ipairs(e.Skeleton) do l.Visible = false end
            continue
        end
        local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
        if dist > Config.ESP.MaxDistance then
            for _, obj in ipairs({e.Box, e.BoxOutline, e.NameTag, e.DistTag, e.HealthBg, e.HealthFill}) do obj.Visible = false end
            for _, l in ipairs(e.Skeleton) do l.Visible = false end
            continue
        end
        local minV, maxV = getBounds(char)
        if not minV then
            for _, obj in ipairs({e.Box, e.BoxOutline, e.NameTag, e.DistTag, e.HealthBg, e.HealthFill}) do obj.Visible = false end
            for _, l in ipairs(e.Skeleton) do l.Visible = false end
            continue
        end
        local minX, minY, maxX, maxY = projectBounds(minV, maxV)
        if not minX then
            for _, obj in ipairs({e.Box, e.BoxOutline, e.NameTag, e.DistTag, e.HealthBg, e.HealthFill}) do obj.Visible = false end
            for _, l in ipairs(e.Skeleton) do l.Visible = false end
            continue
        end
        local boxW = maxX - minX; local boxH = maxY - minY
        e.BoxOutline.Size = Vector2.new(boxW, boxH); e.BoxOutline.Position = Vector2.new(minX, minY)
        e.Box.Size = Vector2.new(boxW, boxH); e.Box.Position = Vector2.new(minX, minY)
        e.NameTag.Position = Vector2.new(minX + boxW/2, minY - 14); e.NameTag.Text = plr.Name
        e.DistTag.Position = Vector2.new(minX + boxW/2, maxY + 2); e.DistTag.Text = string.format("[%d]", math.floor(dist))
        local healthPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        local hbW = 3; local hbGap = 4
        e.HealthBg.Size = Vector2.new(hbW + 2, boxH + 2)
        e.HealthBg.Position = Vector2.new(minX - hbGap - hbW - 1, minY - 1)
        local fillH = boxH * healthPct
        e.HealthFill.Size = Vector2.new(hbW, fillH)
        e.HealthFill.Position = Vector2.new(minX - hbGap - hbW, minY + (boxH - fillH))
        if healthPct > 0.5 then e.HealthFill.Color = Color3.fromRGB(80, 220, 80)
        elseif healthPct > 0.25 then e.HealthFill.Color = Color3.fromRGB(255, 200, 60)
        else e.HealthFill.Color = Color3.fromRGB(255, 60, 60) end
        local head, torso, lhand, rhand, lfoot, rfoot = getSkeletonPoints(char)
        local function scr(part)
            if not part or not part.Parent then return nil end
            local sp, on = Camera:WorldToViewportPoint(part.Position)
            if not on or sp.Z <= 0 then return nil end
            return Vector2.new(sp.X, sp.Y)
        end
        local torsoBottomS = nil
        if torso then
            local tb = torso.Position - Vector3.new(0, torso.Size.Y/2, 0)
            local sp, on = Camera:WorldToViewportPoint(tb)
            if on and sp.Z > 0 then torsoBottomS = Vector2.new(sp.X, sp.Y) end
        end
        local lines = {
            {scr(head), scr(torso)}, {scr(torso), scr(lhand)}, {scr(torso), scr(rhand)},
            {torsoBottomS, scr(lfoot)}, {torsoBottomS, scr(rfoot)}, {scr(lfoot), scr(rfoot)},
        }
        for i = 1, 6 do
            local l = e.Skeleton[i]
            local a, b = lines[i][1], lines[i][2]
            if a and b then l.From = a; l.To = b; l.Visible = Config.ESP.Skeleton
            else l.Visible = false end
        end
        e.Box.Visible = Config.ESP.Box; e.BoxOutline.Visible = Config.ESP.Box
        e.NameTag.Visible = Config.ESP.Name; e.DistTag.Visible = Config.ESP.Distance
        e.HealthBg.Visible = Config.ESP.HealthBar; e.HealthFill.Visible = Config.ESP.HealthBar
    end
end

RunService:BindToRenderStep("tungESP", Enum.RenderPriority.Camera.Value + 1, updateESP)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then toggleMenu() end
end)

print("[tungWare] Загружено! Вкладки: Silent Aim, ESP, Misc")
