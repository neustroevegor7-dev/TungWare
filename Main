    Container.BackgroundTransparency = 1
    Container.AutomaticSize = Enum.AutomaticSize.Y
    Container.Parent = parent
    local CL = Instance.new("UIListLayout")
    CL.Padding = UDim.new(0, 6)
    CL.SortOrder = Enum.SortOrder.LayoutOrder
    CL.Parent = Container
    return Container
end

local function createToggle(parent, text, default, cb)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, -4, 0, 40)
    Row.BackgroundColor3 = Theme.Card
    Row.BackgroundTransparency = 0.3
    Row.Parent = parent
    corner(Row, 10)
    stroke(Row, Theme.Stroke, 1, 0.6)
    gradient(Row, Theme.Card, Theme.Sidebar, 90)

    local L = Instance.new("TextLabel")
    L.Size = UDim2.new(1, -80, 1, 0)
    L.Position = UDim2.new(0, 14, 0, 0)
    L.BackgroundTransparency = 1
    L.Text = text
    L.TextColor3 = Theme.Text
    L.Font = Enum.Font.Gotham
    L.TextSize = 13
    L.TextXAlignment = Enum.TextXAlignment.Left
    L.Parent = Row

    local Switch = Instance.new("Frame")
    Switch.Size = UDim2.new(0, 44, 0, 22)
    Switch.Position = UDim2.new(1, -58, 0.5, -11)
    Switch.BackgroundColor3 = default and Theme.Accent or Theme.ToggleOff
    Switch.Parent = Row
    corner(Switch, 11)
    if default then gradient(Switch, Theme.Accent, Theme.Accent2, 45) end

    local Dot = Instance.new("Frame")
    Dot.Size = UDim2.new(0, 18, 0, 18)
    Dot.Position = default and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
    Dot.BackgroundColor3 = default and Color3.fromRGB(0,0,0) or Theme.Text
    Dot.Parent = Switch
    corner(Dot, 9)

    local state = default or false
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 1, 0)
    Btn.BackgroundTransparency = 1
    Btn.Text = ""
    Btn.Parent = Row

    Btn.MouseButton1Click:Connect(function()
        state = not state
        tween(Switch, 0.25, { BackgroundColor3 = state and Theme.Accent or Theme.ToggleOff })
        tween(Dot, 0.25, { Position = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9) }, Enum.EasingStyle.Back)
        Dot.BackgroundColor3 = state and Color3.fromRGB(0,0,0) or Theme.Text
        if cb then cb(state) end
    end)
end

local function createSlider(parent, text, min, max, default, suffix, cb)
    suffix = suffix or ""
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, -4, 0, 52)
    Row.BackgroundColor3 = Theme.Card
    Row.BackgroundTransparency = 0.3
    Row.Parent = parent
    corner(Row, 10)
    stroke(Row, Theme.Stroke, 1, 0.6)
    gradient(Row, Theme.Card, Theme.Sidebar, 90)

    local L = Instance.new("TextLabel")
    L.Size = UDim2.new(1, -100, 0, 16)
    L.Position = UDim2.new(0, 14, 0, 6)
    L.BackgroundTransparency = 1
    L.Text = text
    L.TextColor3 = Theme.Text
    L.Font = Enum.Font.Gotham
    L.TextSize = 13
    L.TextXAlignment = Enum.TextXAlignment.Left
    L.Parent = Row

    local V = Instance.new("TextLabel")
    V.Size = UDim2.new(0, 90, 0, 16)
    V.Position = UDim2.new(1, -100, 0, 6)
    V.BackgroundTransparency = 1
    V.Text = tostring(default) .. suffix
    V.TextColor3 = Theme.Accent
    V.Font = Enum.Font.GothamBold
    V.TextSize = 12
    V.TextXAlignment = Enum.TextXAlignment.Right
    V.Parent = Row

    local BarBg = Instance.new("Frame")
    BarBg.Size = UDim2.new(1, -28, 0, 8)
    BarBg.Position = UDim2.new(0, 14, 0, 32)
    BarBg.BackgroundColor3 = Theme.ToggleOff
    BarBg.Parent = Row
    corner(BarBg, 4)

    local BarFill = Instance.new("Frame")
    BarFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    BarFill.BackgroundColor3 = Theme.Accent
    BarFill.Parent = BarBg
    corner(BarFill, 4)
    gradient(BarFill, Theme.Accent, Theme.Accent2, 0)

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 16, 0, 16)
    Knob.Position = UDim2.new((default - min) / (max - min), -8, 0.5, -8)
    Knob.BackgroundColor3 = Theme.Text
    Knob.Parent = BarBg
    corner(Knob, 8)
    stroke(Knob, Theme.Accent, 2)

    local drag = false
    local cur = default
    local function upd(x)
        local bx = BarBg.AbsolutePosition.X
        local bw = BarBg.AbsoluteSize.X
        if bw <= 0 then return end
        local pct = math.clamp((x - bx) / bw, 0, 1)
        cur = math.floor((min + (max - min) * pct) * 100) / 100
        BarFill.Size = UDim2.new(pct, 0, 1, 0)
        Knob.Position = UDim2.new(pct, -8, 0.5, -8)
        V.Text = tostring(cur) .. suffix
        if cb then cb(cur) end
    end
    BarBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            drag = true; upd(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if drag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            upd(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end)
end

local function createDropdown(parent, text, options, default, cb)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, -4, 0, 38)
    Row.BackgroundColor3 = Theme.Card
    Row.BackgroundTransparency = 0.3
    Row.ClipsDescendants = true
    Row.Parent = parent
    corner(Row, 10)
    stroke(Row, Theme.Stroke, 1, 0.6)
    gradient(Row, Theme.Card, Theme.Sidebar, 90)

    local L = Instance.new("TextLabel")
    L.Size = UDim2.new(0.5, 0, 1, 0)
    L.Position = UDim2.new(0, 14, 0, 0)
    L.BackgroundTransparency = 1
    L.Text = text
    L.TextColor3 = Theme.Text
    L.Font = Enum.Font.Gotham
    L.TextSize = 13
    L.TextXAlignment = Enum.TextXAlignment.Left
    L.Parent = Row

    local Sel = Instance.new("TextLabel")
    Sel.Size = UDim2.new(0.4, -30, 1, 0)
    Sel.Position = UDim2.new(0.5, 0, 0, 0)
    Sel.BackgroundTransparency = 1
    Sel.Text = default or options[1]
    Sel.TextColor3 = Theme.Accent
    Sel.Font = Enum.Font.GothamBold
    Sel.TextSize = 12
    Sel.TextXAlignment = Enum.TextXAlignment.Right
    Sel.Parent = Row

    local Arrow = Instance.new("TextLabel")
    Arrow.Size = UDim2.new(0, 20, 1, 0)
    Arrow.Position = UDim2.new(1, -25, 0, 0)
    Arrow.BackgroundTransparency = 1
    Arrow.Text = "v"
    Arrow.TextColor3 = Theme.TextDim
    Arrow.Font = Enum.Font.GothamBold
    Arrow.TextSize = 10
    Arrow.Parent = Row

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 38)
    Btn.BackgroundTransparency = 1
    Btn.Text = ""
    Btn.Parent = Row

    local List = Instance.new("Frame")
    List.Size = UDim2.new(1, -20, 0, #options * 30)
    List.Position = UDim2.new(0, 10, 0, 42)
    List.BackgroundTransparency = 1
    List.Visible = false
    List.Parent = Row
    local LL = Instance.new("UIListLayout")
    LL.Padding = UDim.new(0, 2)
    LL.Parent = List

    local opened = false
    local function tog()
        opened = not opened
        List.Visible = opened
        tween(Row, 0.25, { Size = opened and UDim2.new(1, -4, 0, 48 + #options * 32) or UDim2.new(1, -4, 0, 38) })
        tween(Arrow, 0.25, { Rotation = opened and 180 or 0 })
    end

    for _, opt in ipairs(options) do
        local OB = Instance.new("TextButton")
        OB.Size = UDim2.new(1, 0, 0, 28)
        OB.BackgroundColor3 = Theme.Sidebar
        OB.Text = "  " .. opt
        OB.TextColor3 = Theme.TextDim
        OB.Font = Enum.Font.Gotham
        OB.TextSize = 12
        OB.TextXAlignment = Enum.TextXAlignment.Left
        OB.AutoButtonColor = false
        OB.Parent = List
        corner(OB, 6)
        OB.MouseEnter:Connect(function() tween(OB, 0.15, { BackgroundColor3 = Theme.CardHover, TextColor3 = Theme.Text }) end)
        OB.MouseLeave:Connect(function() tween(OB, 0.15, { BackgroundColor3 = Theme.Sidebar, TextColor3 = Theme.TextDim }) end)
        OB.MouseButton1Click:Connect(function()
            Sel.Text = opt; tog()
            if cb then cb(opt) end
        end)
    end
    Btn.MouseButton1Click:Connect(tog)
end

