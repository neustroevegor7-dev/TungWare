    Bar.Position = UDim2.new(0, 6, 0.5, -9)
    Bar.BackgroundColor3 = Theme.Accent
    Bar.Parent = Section
    corner(Bar, 2)

    local T = Instance.new("TextLabel")
    T.Size = UDim2.new(1, -20, 1, 0)
    T.Position = UDim2.new(0, 18, 0, 0)
    T.BackgroundTransparency = 1
