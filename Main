local Drawing = rawget(getfenv(), "Drawing") or (getgenv and getgenv().Drawing)
local hasDrawing = Drawing and Drawing.new and true or false

local Theme = {
    Bg = Color3.fromRGB(12, 12, 12), BgGrad1 = Color3.fromRGB(24, 24, 24), BgGrad2 = Color3.fromRGB(8, 8, 8),
    Sidebar = Color3.fromRGB(8, 8, 8), Card = Color3.fromRGB(24, 24, 24), CardHover = Color3.fromRGB(38, 38, 38),
    Accent = Color3.fromRGB(240, 240, 240), Accent2 = Color3.fromRGB(180, 180, 180), Glow = Color3.fromRGB(255, 255, 255),
    Text = Color3.fromRGB(245, 245, 245), TextDim = Color3.fromRGB(140, 140, 140),
    ToggleOff = Color3.fromRGB(55, 55, 55), Stroke = Color3.fromRGB(50, 50, 50),
}

local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local function corner(p, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 8); c.Parent = p; return c
end
local function stroke(p, col, th, trans)
    local s = Instance.new("UIStroke"); s.Color = col or Theme.Stroke; s.Thickness = th or 1
    s.Transparency = trans or 0; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = p; return s
end
local function tween(o, t, props, style, dir)
    local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
    tw:Play(); return tw
end
local function gradient(p, c1, c2, rot)
    local g = Instance.new("UIGradient"); g.Color = ColorSequence.new(c1, c2); g.Rotation = rot or 90; g.Parent = p; return g
end
local function shadow(p, size, trans)
    local s = Instance.new("ImageLabel"); s.Image = "rbxassetid://5028857084"
    s.ImageColor3 = Color3.fromRGB(0, 0, 0); s.ImageTransparency = trans or 0.45
    s.ScaleType = Enum.ScaleType.Slice; s.SliceCenter = Rect.new(24, 24, 276, 276)
    s.Size = UDim2.new(1, size or 24, 1, size or 24)
    s.Position = UDim2.new(0, -(size or 24)/2, 0, -(size or 24)/2)
    s.BackgroundTransparency = 1; s.ZIndex = -1; s.Parent = p; return s
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "tungWare"
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

if syn and syn.protect_gui then
    syn.protect_gui(ScreenGui)
    ScreenGui.Parent = game:GetService("CoreGui")
elseif gethui then
    ScreenGui.Parent = gethui()
else
    local ok = pcall(function() ScreenGui.Parent = game:GetService("CoreGui") end)
    if not ok then ScreenGui.Parent = LP:WaitForChild("PlayerGui") end
end

