local Pages = {}
local Tabs = {}

local function createTab(name, icon)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, isMobile and 52 or 44)
    Btn.BackgroundColor3 = Theme.Sidebar
    Btn.BackgroundTransparency = 1
    Btn.Text = ""
    Btn.AutoButtonColor = false
    Btn.Parent = TabHolder
    corner(Btn, 12)

    local BgActive = Instance.new("Frame")
    BgActive.Size = UDim2.new(1, 0, 1, 0)
    BgActive.BackgroundColor3 = Theme.Card
    BgActive.BackgroundTransparency = 1
    BgActive.Parent = Btn
    corner(BgActive, 12)
    gradient(BgActive, Theme.Card, Theme.CardHover, 90)

    local Ind = Instance.new("Frame")
    Ind.Size = UDim2.new(0, 3, 0, 0)
    Ind.Position = UDim2.new(0, 0, 0.5, 0)
    Ind.AnchorPoint = Vector2.new(0, 0.5)
    Ind.BackgroundColor3 = Theme.Accent
    Ind.Parent = Btn
    corner(Ind, 2)

    local Icon = Instance.new("TextLabel")
    Icon.Size = UDim2.new(1, 0, 1, 0)
    Icon.BackgroundTransparency = 1
    Icon.Text = icon
    Icon.TextColor3 = Theme.TextDim
    Icon.Font = Enum.Font.GothamBold
    Icon.TextSize = 18
    Icon.Parent = Btn

    if not isMobile then
        Icon.Size = UDim2.new(0, 30, 1, 0)
        Icon.Position = UDim2.new(0, 16, 0, 0)
        Icon.TextSize = 15
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -55, 1, 0)
        lbl.Position = UDim2.new(0, 50, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = name
        lbl.TextColor3 = Theme.TextDim
        lbl.Font = Enum.Font.GothamMedium
        lbl.TextSize = 12
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = Btn
        Btn:SetAttribute("Lbl", lbl)
    end

    local Page = Instance.new("Frame")
    Page.Size = UDim2.new(1, 0, 0, 0)
    Page.BackgroundTransparency = 1
    Page.AutomaticSize = Enum.AutomaticSize.Y
    Page.Visible = false
    Page.Parent = Scroll
    local PL = Instance.new("UIListLayout")
    PL.Padding = UDim.new(0, 10)
    PL.SortOrder = Enum.SortOrder.LayoutOrder
    PL.Parent = Page

    local t = { Btn = Btn, Page = Page, Icon = Icon, BgActive = BgActive, Ind = Ind, Name = name }
    table.insert(Tabs, t)
    Pages[name] = Page

    Btn.MouseButton1Click:Connect(function()
        for _, tt in ipairs(Tabs) do
            tt.Page.Visible = false
            tween(tt.BgActive, 0.25, { BackgroundTransparency = 1 })
            tween(tt.Icon, 0.25, { TextColor3 = Theme.TextDim })
            tween(tt.Ind, 0.25, { Size = UDim2.new(0, 3, 0, 0) })
            if tt.Btn:GetAttribute("Lbl") then
                tween(tt.Btn:GetAttribute("Lbl"), 0.25, { TextColor3 = Theme.TextDim })
            end
        end
        Page.Visible = true
        tween(BgActive, 0.25, { BackgroundTransparency = 0 })
        tween(Icon, 0.25, { TextColor3 = Theme.Accent })
        tween(Ind, 0.3, { Size = UDim2.new(0, 3, 0, 22) }, Enum.EasingStyle.Back)
        if Btn:GetAttribute("Lbl") then
            tween(Btn:GetAttribute("Lbl"), 0.25, { TextColor3 = Theme.Text })
        end
    end)
    return t
end

