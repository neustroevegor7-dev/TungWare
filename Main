local m1 = createSection(Pages["MISC"], "COMBAT")

local function getActiveTool()
    if not LP.Character then return nil end
    return LP.Character:FindFirstChildOfClass("Tool")
end

local originals = {}

local function applyMods()
    local tool = getActiveTool()
    if not tool then return end
    if not originals[tool] then
        originals[tool] = {
            recoilMin = tool:GetAttribute("recoilMin"),
            recoilMax = tool:GetAttribute("recoilMax"),
            spread = tool:GetAttribute("spread"),
            rateOfFire = tool:GetAttribute("rateOfFire"),
            _ammo = tool:GetAttribute("_ammo"),
            magazineSize = tool:GetAttribute("magazineSize"),
            rayRadius = tool:GetAttribute("rayRadius"),
        }
    end
    
    if Config.Misc.NoRecoil then
        pcall(function()
            tool:SetAttribute("recoilMin", Vector2.new(0, 0))
            tool:SetAttribute("recoilMax", Vector2.new(0, 0))
        end)
    end
    if Config.Misc.NoSpread then
        pcall(function() tool:SetAttribute("spread", 0) end)
    end
    if Config.Misc.RapidFire then
        pcall(function() tool:SetAttribute("rateOfFire", Config.Misc.RapidFireVal) end)
    end
    if Config.Misc.InfAmmo then
        pcall(function()
            tool:SetAttribute("_ammo", 9999)
            tool:SetAttribute("magazineSize", 9999)
        end)
    end
    if Config.Misc.Wallbang then
        pcall(function() tool:SetAttribute("rayRadius", Config.Misc.WallbangVal) end)
    end
end

RunService.Heartbeat:Connect(applyMods)

createToggle(m1, "No Recoil", false, function(v) Config.Misc.NoRecoil = v end)
createToggle(m1, "No Spread", false, function(v) Config.Misc.NoSpread = v end)
createToggle(m1, "Rapid Fire", false, function(v) Config.Misc.RapidFire = v end)
createSlider(m1, "Fire Rate", 500, 10000, 2000, "", function(v) Config.Misc.RapidFireVal = v end)
createToggle(m1, "Wallbang", false, function(v) Config.Misc.Wallbang = v end)
